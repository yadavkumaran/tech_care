# ==============================================================================
# TechCare Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>:<PORT>/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=your_secure_database_password_here

# JWT Security Configuration (Secret must be at least 256 bits / 32+ characters)
TECHCARE_JWT_SECRET=your_rotated_random_256_bit_jwt_secret_key_here
TECHCARE_JWT_EXPIRATION_MS=86400000

# Supabase Storage Configuration (Optional)
TECHCARE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
TECHCARE_SUPABASE_KEY=your_supabase_anon_or_service_key
TECHCARE_SUPABASE_BUCKET=techcare-attachments

